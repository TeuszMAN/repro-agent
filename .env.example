# Copy this file to .env and fill in the values. .env is ignored by git.

# Provider: gemini or deepseek
REPRO_PROVIDER=gemini

# Model name for the chosen provider, for example gemini-2.5-flash or deepseek-chat
REPRO_MODEL=gemini-2.5-flash

# API key of the chosen provider (only that one is needed)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: timeout of each LLM call, in seconds (default 60)
# REPRO_LLM_TIMEOUT=60

# Optional: prices in US dollars per million tokens, used to estimate cost.
# Check the provider's price page. Without them, the cost is reported as null.
# REPRO_PRICE_INPUT_PER_MTOK=
# REPRO_PRICE_OUTPUT_PER_MTOK=

# Optional: DeepSeek API address (default https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
